# Logging
Logging__LogLevel__Default=Information
Logging__LogLevel__Hookpipe=Debug
Logging__LogLevel__Microsoft.AspNetCore=Warning

# RabbitMQ sink
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Kafka sink
KAFKA_BROKERS=localhost:9092

# HTTP relay sink
# HTTP_RELAY_URL=https://downstream.example.com/webhook

# SQS sink
# SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789/my-queue
# AWS_REGION=us-east-1

# Seq (optional — set to enable)
# SEQ_URL=http://localhost:5341
# SEQ_API_KEY=

# Loki (optional — set to enable)
# LOKI_URL=http://localhost:3100

# Hookpipe config path (optional, defaults to config/hookpipe.yaml)
# HOOKPIPE_CONFIG_PATH=config/hookpipe.yaml

# Max request body size in MB (optional, defaults to 10)
# HOOKPIPE_MAX_BODY_SIZE_MB=10
