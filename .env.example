# Logging
Logging__LogLevel__Default=Information
Logging__LogLevel__Runax=Debug
Logging__LogLevel__Microsoft.AspNetCore=Warning

# Broker connections. These names are only conventions: the config reads whatever variables it
# references with ${…}, such as `uri: ${RABBITMQ_URL}` (see config/hookpipe.yaml).
RABBITMQ_URL=amqp://guest:guest@localhost:5672
KAFKA_BROKERS=localhost:9092
# HTTP_RELAY_URL=https://downstream.example.com/webhook
# AWS_REGION=us-east-1

# Seq (optional — set to enable)
# SEQ_URL=http://localhost:5341
# SEQ_API_KEY=

# Loki (optional — set to enable)
# LOKI_URL=http://localhost:3100

# Hookpipe config path (optional, defaults to config/hookpipe.yaml)
# HOOKPIPE_CONFIG_PATH=config/hookpipe.yaml

# The request body limit is a config key, not an env var: set `server.max_body_size: 25MB` in
# config/hookpipe.yaml, or `max_body_size` on a single webhook.
