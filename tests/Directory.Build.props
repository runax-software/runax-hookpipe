<Project>

  <!-- Common build settings for all TEST projects under tests.
       Self-contained (MSBuild imports only the nearest Directory.Build.props).
       The test RUNNER (Microsoft.Testing.Platform) is selected in global.json;
       test-framework packages (xUnit v3) are versioned centrally in Directory.Packages.props. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xUnit1051: don't force TestContext.Current.CancellationToken on every cancellable call. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="NSubstitute" />
  </ItemGroup>

</Project>
