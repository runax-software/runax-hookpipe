<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <!-- Runs on every framework the library targets, so no asset ships only compiled and never
       executed. The Api project and its tests stay on net10.0: the service isn't packaged. -->
  <PropertyGroup>
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Runax.Hookpipe\Runax.Hookpipe.csproj" />
  </ItemGroup>

  <!-- TestHost ships one asset per shared framework, so its major has to match the TFM being
       tested. The central version covers net10.0; the older TFMs pin their own. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Microsoft.AspNetCore.TestHost" VersionOverride="9.0.4" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.AspNetCore.TestHost" VersionOverride="8.0.15" />
  </ItemGroup>

</Project>
